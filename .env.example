# Required on Railway
DISCORD_TOKEN=
MILESTONE_GUILD_ID=
MILESTONE_CHANNEL_ID=

# Optional after the first run. If blank, the service creates the milestone message
# and logs its message ID so you can save it here for future restarts.
MILESTONE_MESSAGE_ID=

# Five minutes is plenty; the service only edits the message when the count changes.
REFRESH_INTERVAL_MS=300000

# Local testing only. Set TEST_MODE=true and TEST_SERVERS=99 or 100.
TEST_MODE=false
TEST_SERVERS=99
